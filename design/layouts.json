[
 {
  "id": "editorial-grid",
  "describe": "A 12-column editorial grid. Sections sit on the grid; headlines can span wide while body text keeps to 7 columns. Asymmetric, left-aligned, generous whitespace.",
  "css": "main{max-width:1200px;margin:0 auto;padding:clamp(20px,4vw,56px)}main>section{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));column-gap:clamp(12px,2vw,28px);padding:clamp(28px,5vw,72px) 0;border-top:1px solid var(--line)}main>section>*{grid-column:1/-1}@media(min-width:860px){main>section>p,main>section>.m-body{grid-column:1/span 7}main>section>aside{grid-column:9/span 4;grid-row:span 3}}"
 },
 {
  "id": "single-column",
  "describe": "One long left-aligned reading column, about 64 characters wide. Quiet rhythm, section breaks are whitespace and a small kicker, nothing centered.",
  "css": "main{max-width:44rem;margin:0 auto;padding:clamp(24px,6vw,72px) clamp(16px,5vw,32px)}main>section{padding:clamp(28px,6vw,64px) 0}main>section+section{border-top:1px solid var(--line)}"
 },
 {
  "id": "bento",
  "describe": "A bento box of tiles. Each section is a tile with the surface color and a hairline border, not shadows. The first tile spans the full width; the rest sit two to a row on desktop and match heights, so later sections are roughly half the page wide.",
  "css": "main{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,420px),1fr));gap:clamp(10px,1.4vw,16px);padding:clamp(12px,2vw,24px);max-width:1320px;margin:0 auto}main>section{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:clamp(18px,2.4vw,28px);min-width:0}main>section:first-child{grid-column:1/-1}"
 },
 {
  "id": "full-bleed",
  "describe": "Full-bleed bands. Every section is the full width of the window and close to a screen tall, alternating background and surface colors. Big type, one idea per band.",
  "css": "main{padding:0}main>section{min-height:88vh;padding:clamp(28px,7vw,110px) clamp(16px,6vw,96px);display:flex;flex-direction:column;justify-content:center}main>section:nth-child(even){background:var(--surface)}"
 },
 {
  "id": "split",
  "describe": "A split screen. On wide screens the first section stays pinned in the left 40% while the rest scroll on the right. On phones it stacks.",
  "css": "main{padding:0}@media(min-width:900px){main{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,3fr)}main>section:first-child{position:sticky;top:0;height:100vh;grid-row:1/span 50;border-right:1px solid var(--line);overflow:auto}main>section{grid-column:2}main>section:first-child{grid-column:1}}main>section{padding:clamp(24px,5vw,64px)}main>section+section{border-top:1px solid var(--line)}"
 },
 {
  "id": "terminal",
  "describe": "A terminal or console. Monospace everywhere, section headings read like prompts, data is aligned in fixed columns. No rounded corners.",
  "css": "body{font-family:var(--font-mono)}h1,h2,h3{font-family:var(--font-mono);letter-spacing:0}main{max-width:62rem;margin:0 auto;padding:clamp(16px,4vw,48px)}main>section{padding:clamp(20px,4vw,40px) 0;border-top:1px dashed var(--line)}main>section h2::before{content:'> ';color:var(--accent)}:root{--radius:0px}"
 },
 {
  "id": "broadsheet",
  "describe": "A newspaper broadsheet. A masthead first section, then sections separated by thin rules, with small caps kickers and dense type. To set three or more paragraphs in newspaper columns, wrap them in <div class=\"m-columns\">; keep short intros as a single paragraph.",
  "css": "main{max-width:1240px;margin:0 auto;padding:clamp(16px,3vw,40px)}main>section:first-child{border-bottom:3px double var(--fg);padding-bottom:18px}main>section{padding:clamp(18px,3vw,32px) 0;border-bottom:1px solid var(--line)}@media(min-width:900px){main>section .m-columns{column-count:2;column-gap:40px;column-rule:1px solid var(--line)}}"
 },
 {
  "id": "card-stack",
  "describe": "A stack of cards, each section a card slightly offset from the one above, like index cards dealt on a table. Narrow and tactile.",
  "css": "main{max-width:46rem;margin:0 auto;padding:clamp(16px,4vw,48px) clamp(12px,4vw,32px) 80px}main>section{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:clamp(20px,4vw,40px);margin-top:-6px;position:relative}main>section:nth-child(odd){transform:rotate(-.4deg)}main>section:nth-child(even){transform:rotate(.4deg) translateX(6px)}main>section+section{margin-top:18px}@media(prefers-reduced-motion:reduce){main>section{transform:none!important}}"
 },
 {
  "id": "index",
  "describe": "A numbered index. Each section carries a large number in a left gutter, like chapters in a field guide.",
  "css": "main{max-width:64rem;margin:0 auto;padding:clamp(20px,4vw,56px);counter-reset:sec}main>section{counter-increment:sec;position:relative;padding:clamp(24px,4vw,48px) 0 clamp(24px,4vw,48px) clamp(0px,9vw,120px);border-top:1px solid var(--line)}main>section::before{content:counter(sec,decimal-leading-zero);font-family:var(--font-display);font-size:clamp(28px,6vw,72px);line-height:1;color:var(--accent);display:block;margin-bottom:12px}@media(min-width:760px){main>section::before{position:absolute;left:0;top:clamp(24px,4vw,48px)}}"
 },
 {
  "id": "poster",
  "describe": "A poster. The first section fills the window with one enormous statement set off-center; later sections are smaller and hang from a strong left edge.",
  "css": "main{padding:0 clamp(16px,5vw,72px) 64px}main>section:first-child{min-height:96vh;display:flex;flex-direction:column;justify-content:flex-end;padding-bottom:clamp(24px,6vw,80px)}main>section:first-child h1{font-size:clamp(48px,12vw,180px);line-height:.9;max-width:14ch}main>section{padding:clamp(24px,5vw,64px) 0;max-width:60rem}"
 }
]
